__pycache__/
*.py[cod]
*.sqlite3
.pytest_cache/
.ruff_cache/
.coverage

# Local runtime configuration and secret artifacts must never enter an image.
.env
.env.*
*.env
*.env.*
*.envrc
*.secret
*.secrets
*.credentials
*.token
*.tokens
secrets/
credentials/
private/
.aws/
.ssh/
secrets/**
credentials/**
private/**
.aws/**
.ssh/**

# Apply the local-secret exclusions at every depth in the build context.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*.envrc
**/*.secret
**/*.secrets
**/*.credentials
**/*.token
**/*.tokens
**/secrets/
**/credentials/
**/private/
**/.aws/
**/.ssh/
**/secrets/**
**/credentials/**
**/private/**
**/.aws/**
**/.ssh/**

# Private keys and local signing material are supplied only at release time.
*.key
*.pem
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.gpg
*.pgp
id_rsa
id_ecdsa
id_ed25519
signing/
signing.properties
signing.properties.*
keystore.properties
keystore.properties.*
signing/**

# Apply the private-key and signing exclusions at every depth as well.
**/*.key
**/*.pem
**/*.p8
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.gpg
**/*.pgp
**/id_rsa
**/id_ecdsa
**/id_ed25519
**/signing/
**/signing/**
**/signing.properties
**/signing.properties.*
**/keystore.properties
**/keystore.properties.*

media/
staticfiles/
signage/tests/
