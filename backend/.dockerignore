__pycache__/
*.py[cod]
*.sqlite3
.pytest_cache/
.ruff_cache/
.coverage

# Local runtime configuration and secret artifacts must never enter an image.
.env
.env.*
*.env
*.env.*
*.envrc
*.secret
*.secrets
*.credentials
*.token
*.tokens
secrets/
credentials/
private/
.aws/
.ssh/
.docker/
.config/gcloud/
secrets/**
credentials/**
private/**
.aws/**
.ssh/**
.docker/**
.config/gcloud/**

# Known local runtime credentials are intentionally exact, not broad JSON rules.
play-integrity.json
application-secret.json
django-secret-key
database-password
email-host-user
email-host-password
service-account*.json
.netrc
.pypirc
pip.conf
.git-credentials

# Apply the local-secret exclusions at every depth in the build context.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*.envrc
**/*.secret
**/*.secrets
**/*.credentials
**/*.token
**/*.tokens
**/secrets/
**/credentials/
**/private/
**/.aws/
**/.ssh/
**/.docker/
**/.config/gcloud/
**/secrets/**
**/credentials/**
**/private/**
**/.aws/**
**/.ssh/**
**/.docker/**
**/.config/gcloud/**
**/play-integrity.json
**/application-secret.json
**/django-secret-key
**/database-password
**/email-host-user
**/email-host-password
**/service-account*.json
**/.netrc
**/.pypirc
**/pip.conf
**/.git-credentials

# Private keys and local signing material are supplied only at release time.
*.key
*.pem
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.gpg
*.pgp
id_rsa
id_ecdsa
id_ed25519
id_dsa
id_xmss
id_ecdsa_sk
id_ed25519_sk
signing/
signing.properties
signing.properties.*
keystore.properties
keystore.properties.*
signing/**

# Apply the private-key and signing exclusions at every depth as well.
**/*.key
**/*.pem
**/*.p8
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.gpg
**/*.pgp
**/id_rsa
**/id_ecdsa
**/id_ed25519
**/id_dsa
**/id_xmss
**/id_ecdsa_sk
**/id_ed25519_sk
**/signing/
**/signing/**
**/signing.properties
**/signing.properties.*
**/keystore.properties
**/keystore.properties.*

media/
staticfiles/
signage/tests/
