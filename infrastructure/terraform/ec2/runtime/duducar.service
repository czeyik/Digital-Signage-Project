[Unit]
Description=DUDU signage Caddy, Django, and PostgreSQL stack
Requires=docker.service duducar-credential-broker.service
After=docker.service duducar-credential-broker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/duducar
OnFailure=duducar-alert@%n.service

[Service]
Type=simple
UMask=0077
ExecStartPre=/usr/local/sbin/render-duducar-runtime-env
ExecStartPre=/usr/local/sbin/duducar-stack start
ExecStart=/usr/local/sbin/duducar-stack monitor
ExecStartPost=/usr/local/sbin/duducar-alert --clear duducar.service "The DUDU production stack is healthy again."
ExecStop=/usr/local/sbin/duducar-stack stop
Restart=on-failure
RestartSec=10s
TimeoutStartSec=10min
TimeoutStopSec=3min

[Install]
WantedBy=multi-user.target
