#!/usr/bin/python3
"""Expose only the scoped application role through the ECS credential protocol."""

import hmac
import json
import os
import stat
import subprocess
import threading
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


BIND_ADDRESS = "169.254.170.2"
BIND_PORT = 51679
CREDENTIAL_PATH = "/v2/credentials"
TOKEN_PATH = "/run/duducar/backend-secrets/aws-credentials-token"
REFRESH_BEFORE = timedelta(minutes=5)

_credentials = None
_credentials_lock = threading.Lock()


def required_environment(name):
    value = os.environ.get(name, "").strip()
    if not value:
        raise RuntimeError(f"Missing required broker setting: {name}")
    return value


def authorization_token():
    descriptor = os.open(TOKEN_PATH, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise RuntimeError("Credential token is not a regular file.")
        if metadata.st_uid != 10001 or stat.S_IMODE(metadata.st_mode) != 0o400:
            raise RuntimeError("Credential token ownership or mode is unsafe.")
        with os.fdopen(descriptor, encoding="ascii") as handle:
            descriptor = -1
            token = handle.read().strip()
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if len(token) != 64 or any(character not in "0123456789abcdef" for character in token):
        raise RuntimeError("Credential token is not a canonical 256-bit value.")
    return token


def expiration_time(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(timezone.utc)


def assume_application_role():
    role_arn = required_environment("APPLICATION_ROLE_ARN")
    region = required_environment("AWS_REGION")
    result = subprocess.run(
        [
            "/usr/bin/aws",
            "sts",
            "assume-role",
            "--region",
            region,
            "--role-arn",
            role_arn,
            "--role-session-name",
            "duducar-web",
            "--duration-seconds",
            "3600",
            "--output",
            "json",
        ],
        check=True,
        capture_output=True,
        env={**os.environ, "AWS_EC2_METADATA_DISABLED": "false"},
        text=True,
        timeout=30,
    )
    document = json.loads(result.stdout)
    source = document["Credentials"]
    response = {
        "AccessKeyId": source["AccessKeyId"],
        "SecretAccessKey": source["SecretAccessKey"],
        "Token": source["SessionToken"],
        "Expiration": source["Expiration"],
    }
    if expiration_time(response["Expiration"]) <= datetime.now(timezone.utc) + REFRESH_BEFORE:
        raise RuntimeError("STS returned credentials too close to expiry.")
    return response


def current_credentials():
    global _credentials
    with _credentials_lock:
        if _credentials is not None:
            expiry = expiration_time(_credentials["Expiration"])
            if expiry > datetime.now(timezone.utc) + REFRESH_BEFORE:
                return _credentials
        _credentials = assume_application_role()
        return _credentials


class CredentialHandler(BaseHTTPRequestHandler):
    server_version = "duducar-credential-broker"
    sys_version = ""

    def do_GET(self):
        if self.path != CREDENTIAL_PATH:
            self.send_error(404)
            return
        supplied = self.headers.get("Authorization", "")
        try:
            expected = authorization_token()
        except (OSError, RuntimeError):
            self.send_error(503)
            return
        if not hmac.compare_digest(supplied, expected):
            self.send_error(401)
            return
        try:
            payload = json.dumps(current_credentials(), separators=(",", ":")).encode()
        except (KeyError, OSError, RuntimeError, subprocess.SubprocessError, json.JSONDecodeError):
            self.send_error(503)
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, _format, *_args):
        return


def main():
    authorization_token()
    current_credentials()
    server = ThreadingHTTPServer((BIND_ADDRESS, BIND_PORT), CredentialHandler)
    server.daemon_threads = True
    server.serve_forever()


if __name__ == "__main__":
    main()
