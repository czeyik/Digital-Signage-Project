[Unit]
Description=DUDU scoped AWS application credential broker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Before=duducar.service
PartOf=duducar.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/duducar/host.env
ExecStartPre=/usr/local/sbin/render-duducar-runtime-env
ExecStartPre=/usr/local/sbin/duducar-stack prepare
ExecStartPre=/usr/sbin/ip address replace 169.254.170.2/32 dev lo
ExecStart=/usr/local/sbin/duducar-credential-broker
ExecStopPost=-/usr/sbin/ip address del 169.254.170.2/32 dev lo
Restart=on-failure
RestartSec=5s
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
