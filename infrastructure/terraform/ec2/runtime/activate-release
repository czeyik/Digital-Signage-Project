#!/bin/bash
# Validate or activate one Terraform-reviewed release. Activation is deliberately
# separate from runtime/config installation and requires an operation-bound phrase.
set -Eeuo pipefail
umask 0077

mode=${1:-}
commit=${2:-}
operation_id=${3:-}
confirmation=${4:-}
activation_kind=${5:-}
backend_image=${6:-}
postgres_image=${7:-}
caddy_image=${8:-}
required_app_version=${9:-}
recovery_from_operation_id=${10:-}
failed_activation_command_id=${11:-}
manifest_dir=${12:-}
runtime_manager=${13:-}

host_config=/etc/duducar/host.env
release_config=/etc/duducar/release.env
postgres_data_dir=/srv/duducar/postgres
stack_command=/usr/local/sbin/duducar-stack
command_command=/usr/local/sbin/duducar-command
backup_verify_command=/usr/local/sbin/duducar-backup-verify
host_health_command=/usr/local/sbin/duducar-host-health
render_runtime_env=/usr/local/sbin/render-duducar-runtime-env
alert_command=/usr/local/sbin/duducar-alert
recovery_state_dir=/var/lib/duducar-recovery

if [ -n "${DUDUCAR_ACTIVATION_TEST_ROOT:-}" ]; then
  [[ "$DUDUCAR_ACTIVATION_TEST_ROOT" =~ ^/tmp/duducar-activation-test\.[A-Za-z0-9]{6,}$ ]] || {
    echo "Activation test root is outside the permitted temporary path." >&2
    exit 2
  }
  host_config="$DUDUCAR_ACTIVATION_TEST_ROOT/etc/duducar/host.env"
  release_config="$DUDUCAR_ACTIVATION_TEST_ROOT/etc/duducar/release.env"
  postgres_data_dir="$DUDUCAR_ACTIVATION_TEST_ROOT/srv/duducar/postgres"
  stack_command="$DUDUCAR_ACTIVATION_TEST_ROOT/usr/local/sbin/duducar-stack"
  command_command="$DUDUCAR_ACTIVATION_TEST_ROOT/usr/local/sbin/duducar-command"
  backup_verify_command="$DUDUCAR_ACTIVATION_TEST_ROOT/usr/local/sbin/duducar-backup-verify"
  host_health_command="$DUDUCAR_ACTIVATION_TEST_ROOT/usr/local/sbin/duducar-host-health"
  render_runtime_env="$DUDUCAR_ACTIVATION_TEST_ROOT/usr/local/sbin/render-duducar-runtime-env"
  alert_command="$DUDUCAR_ACTIVATION_TEST_ROOT/usr/local/sbin/duducar-alert"
  recovery_state_dir="$DUDUCAR_ACTIVATION_TEST_ROOT/var/lib/duducar-recovery"
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "Release activation must run as root." >&2
  exit 2
fi
case "$mode" in validate|arm-failed-existing|activate) ;; *) echo "Mode must be validate, arm-failed-existing, or activate." >&2; exit 2 ;; esac
case "$activation_kind" in existing|failed-existing|initial-empty) ;; *) echo "ActivationKind must be existing, failed-existing, or initial-empty." >&2; exit 2 ;; esac
[[ "$commit" =~ ^[0-9a-f]{40}$ ]]
[[ "$operation_id" =~ ^[0-9a-f]{32}$ ]]
for image in "$backend_image" "$postgres_image" "$caddy_image"; do
  [[ "$image" =~ ^[A-Za-z0-9][A-Za-z0-9./:_-]*@sha256:[0-9a-f]{64}$ ]] || {
    echo "Every activated image must be pinned by SHA-256 digest." >&2
    exit 2
  }
done
[[ "$required_app_version" =~ ^[0-9]+[.][0-9]+[.][0-9]+([-+][0-9A-Za-z.-]+)?$ ]]
if [ "$activation_kind" = failed-existing ]; then
  [[ "$recovery_from_operation_id" =~ ^[0-9a-f]{32}$ ]] || {
    echo "Failed-existing recovery requires the prior operation ID." >&2
    exit 2
  }
  [[ "$failed_activation_command_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || {
    echo "Failed-existing recovery requires the prior SSM command ID." >&2
    exit 2
  }
elif [ -n "$recovery_from_operation_id$failed_activation_command_id" ]; then
  echo "Recovery evidence is accepted only for failed-existing activation." >&2
  exit 2
fi
if [ "$activation_kind" = failed-existing ] && [ "$recovery_from_operation_id" = "$operation_id" ]; then
  echo "Failed-existing recovery must use a different prior operation ID." >&2
  exit 2
fi
recovery_state_max_age=900
recovery_state_file="$recovery_state_dir/$operation_id"
recovery_claim_dir="$recovery_state_dir/.claim-$operation_id"

if ! test -f "$release_config" || test -L "$release_config" || \
  [ "$(stat -c '%U:%G' "$release_config")" != root:root ] || \
  [ $((8#$(stat -c '%a' "$release_config") & 0022)) -ne 0 ]; then
  echo "release.env must be a root-owned, non-writable regular file." >&2
  exit 1
fi

assignment_value() {
  key=$1
  awk -v key="$key" '
    $0 ~ ("^" key "=") { count++; value = substr($0, length(key) + 2) }
    END { if (count != 1) exit 1; print value }
  ' "$release_config"
}

[ "$(assignment_value BACKEND_IMAGE)" = "$backend_image" ]
[ "$(assignment_value POSTGRES_IMAGE)" = "$postgres_image" ]
[ "$(assignment_value CADDY_IMAGE)" = "$caddy_image" ]
[ "$(assignment_value REQUIRED_APP_VERSION)" = "$required_app_version" ]
[ "$(assignment_value CADDY_CONFIG)" = /etc/duducar/Caddyfile.post-cutover ]

"$runtime_manager" assert "$commit" "$operation_id" "$manifest_dir" "$caddy_image"
"$render_runtime_env"

timers=(
  duducar-health.timer
  duducar-playlists.timer
  duducar-media-reconcile.timer
  duducar-retention.timer
  duducar-backup.timer
)

source_host_config() {
  set -a
  source "$host_config"
  set +a
}

backup_receipt_is_current() {
  DUDUCAR_BACKUP_ASSUME_ROLE=1 \
    DUDUCAR_BACKUP_EXPECTED_OPERATION_ID="$operation_id" \
    "$backup_verify_command" check
}

refresh_stopped_backup() (
  set -Eeuo pipefail
  cleanup() {
    original_status=$?
    status=$original_status
    set +e
    "$stack_command" stop || status=1
    systemctl stop duducar-credential-broker.service || status=1

    running_duducar_containers=$(docker ps --format '{{.Names}}' 2>/dev/null) || status=1
    if grep -Eq '^duducar-' <<< "$running_duducar_containers"; then
      status=1
    fi
    public_listeners=$(ss -ltnH '( sport = :80 or sport = :443 )' 2>/dev/null) || status=1
    if [ -n "$public_listeners" ]; then
      status=1
    fi
    exit "$status"
  }
  trap cleanup EXIT

  systemctl start duducar-credential-broker.service
  "$stack_command" backup-start
  "$command_command" backup-refresh "$operation_id"
  backup_receipt_is_current
)

ensure_failed_existing_backup() {
  if backup_receipt_is_current; then
    return
  fi
  refresh_stopped_backup
  backup_receipt_is_current
}

existing_preflight() {
  # Preflight assumes only the scoped application role, leaving the live stack
  # untouched if a credential broker problem is found before traffic shutdown.
  # render-duducar-runtime-env above verified this root-owned configuration;
  # export its backup bucket for the verifier's direct preflight invocation.
  source_host_config
  DUDUCAR_BACKUP_ASSUME_ROLE=1 "$backup_verify_command" check
  DUDUCAR_BACKUP_ASSUME_ROLE=1 "$host_health_command"
}

write_recovery_state() {
  install -d -o root -g root -m 0700 "$recovery_state_dir"
  if [ -e "$recovery_state_file" ] || [ -L "$recovery_state_file" ] || [ -e "$recovery_claim_dir" ]; then
    echo "A recovery authorization already exists for this operation." >&2
    return 1
  fi
  recovery_state_tmp=$(mktemp "$recovery_state_dir/.recovery.XXXXXX")
  printf 'commit=%s\noperation_id=%s\nrecovery_from_operation_id=%s\nfailed_activation_command_id=%s\narmed_at=%s\n' \
    "$commit" "$operation_id" "$recovery_from_operation_id" "$failed_activation_command_id" "$(date +%s)" \
    > "$recovery_state_tmp"
  chown root:root "$recovery_state_tmp"
  chmod 0400 "$recovery_state_tmp"
  mv -f -- "$recovery_state_tmp" "$recovery_state_file"
}

assert_recovery_state() {
  if ! test -f "$recovery_state_file" || test -L "$recovery_state_file" || \
    [ "$(stat -c '%U:%G:%a' "$recovery_state_file")" != root:root:400 ]; then
    echo "Failed-existing recovery requires a root-only, armed recovery authorization." >&2
    return 1
  fi
  mapfile -t recovery_state_lines < "$recovery_state_file"
  [ "${#recovery_state_lines[@]}" -eq 5 ] && \
    [ "${recovery_state_lines[0]}" = "commit=$commit" ] && \
    [ "${recovery_state_lines[1]}" = "operation_id=$operation_id" ] && \
    [ "${recovery_state_lines[2]}" = "recovery_from_operation_id=$recovery_from_operation_id" ] && \
    [ "${recovery_state_lines[3]}" = "failed_activation_command_id=$failed_activation_command_id" ] || {
      echo "Recovery authorization does not match this reviewed operation." >&2
      return 1
    }
  armed_at=${recovery_state_lines[4]#armed_at=}
  [[ "$armed_at" =~ ^[0-9]{10}$ ]] || {
    echo "Recovery authorization has an invalid timestamp." >&2
    return 1
  }
  now=$(date +%s)
  if [ "$armed_at" -gt "$now" ] || [ $((now - armed_at)) -gt "$recovery_state_max_age" ]; then
    echo "Recovery authorization has expired; arm a new reviewed operation." >&2
    return 1
  fi
}

consume_recovery_state() {
  if ! mkdir -m 0700 "$recovery_claim_dir"; then
    echo "Failed-existing recovery authorization has already been claimed." >&2
    return 1
  fi
  if ! assert_recovery_state; then
    rmdir -- "$recovery_claim_dir" 2>/dev/null || true
    return 1
  fi
  rm -f -- "$recovery_state_file"
}

verify_recovery_alert_delivery() {
  recovery_alert="duducar-recovery-sns-${operation_id}-${mode}"
  "$alert_command" --problem "$recovery_alert" \
    "Recovery activation $operation_id is validating Operations SNS delivery."
  "$alert_command" --clear "$recovery_alert" \
    "Recovery activation $operation_id verified Operations SNS delivery."
}

failed_existing_preflight() {
  # This narrow recovery path is only safe while the prior fail-closed attempt
  # has left every DUDU lifecycle unit and public container stopped.
  for unit in duducar-credential-broker.service duducar.service "${timers[@]}"; do
    [ "$(systemctl is-active "$unit" || true)" = inactive ] || {
      echo "Failed-existing recovery requires $unit to be inactive." >&2
      return 1
    }
    enabled_state=$(systemctl is-enabled "$unit" || true)
    if [ "$unit" = duducar-credential-broker.service ]; then
      case "$enabled_state" in enabled|disabled) ;; *)
        echo "Failed-existing recovery requires $unit to be enabled or disabled, not $enabled_state." >&2
        return 1
        ;;
      esac
    elif [ "$enabled_state" != enabled ]; then
      echo "Failed-existing recovery requires $unit to remain enabled, not $enabled_state." >&2
      return 1
    fi
  done
  running_duducar_containers=$(docker ps --format '{{.Names}}')
  if grep -Eq '^duducar-' <<< "$running_duducar_containers"; then
    echo "Failed-existing recovery requires every DUDU container to be stopped." >&2
    return 1
  fi
  public_listeners=$(ss -ltnH '( sport = :80 or sport = :443 )')
  if [ -n "$public_listeners" ]; then
    echo "Failed-existing recovery requires ports 80 and 443 to be unbound." >&2
    return 1
  fi

  source_host_config
  ensure_failed_existing_backup
  # Public HTTPS is necessarily unavailable while the fail-closed stack is
  # stopped. The unskipped check below is mandatory after systemd restores it.
  DUDUCAR_BACKUP_ASSUME_ROLE=1 \
    DUDUCAR_BACKUP_EXPECTED_OPERATION_ID="$operation_id" \
    "$host_health_command" --skip-public-https
  verify_recovery_alert_delivery
  printf 'Failed-existing recovery is correlated with operation %s and SSM command %s.\n' \
    "$recovery_from_operation_id" "$failed_activation_command_id"
}

if [ "$mode" = validate ]; then
  [ -z "$confirmation" ] || {
    echo "Validation requires an empty confirmation." >&2
    exit 2
  }
  if [ "$activation_kind" = failed-existing ]; then
    failed_existing_preflight
  fi
  echo "Release activation validation passed; temporary backup components were cleaned up and no production stack was activated."
  exit 0
fi

if [ "$mode" = arm-failed-existing ]; then
  [ "$activation_kind" = failed-existing ] || {
    echo "Only failed-existing activation may arm a recovery authorization." >&2
    exit 2
  }
  [ "$confirmation" = "ARM $operation_id FROM $recovery_from_operation_id" ] || {
    echo "Recovery arming requires the exact operation-bound confirmation phrase." >&2
    exit 2
  }
  failed_existing_preflight
  write_recovery_state
  echo "Failed-existing recovery authorization is armed; temporary backup components were cleaned up and no production stack is active."
  exit 0
fi

expected_confirmation="ACTIVATE $operation_id"
if [ "$activation_kind" = failed-existing ]; then
  expected_confirmation="RECOVER $operation_id FROM $recovery_from_operation_id"
fi
[ "$confirmation" = "$expected_confirmation" ] || {
  echo "Activation requires the exact operation-bound confirmation phrase for its activation kind." >&2
  exit 2
}
traffic_changed=0
cleanup() {
  status=$?
  set +e
  if [ "$status" -ne 0 ] && [ "$traffic_changed" -eq 1 ]; then
    systemctl stop "${timers[@]}" duducar.service duducar-credential-broker.service
    "$stack_command" stop || true
    "$alert_command" duducar-activation \
      "Release activation $operation_id failed after traffic shutdown; the stack remains stopped." || true
  fi
  exit "$status"
}
trap cleanup EXIT

case "$activation_kind" in
  existing)
    existing_preflight
    ;;
  failed-existing)
    failed_existing_preflight
    ;;
  initial-empty)
    if find "$postgres_data_dir" -mindepth 1 -print -quit | grep -q .; then
      echo "Initial-empty activation requires an empty PostgreSQL data directory." >&2
      exit 1
    fi
    ;;
esac

if [ "$activation_kind" = failed-existing ]; then
  # Do not consume the arm until every stopped-state preflight, including a
  # possible backup refresh, has passed. A failed preflight remains retryable;
  # once this claim succeeds, any later failure is fail-closed.
  consume_recovery_state
fi

traffic_changed=1
systemctl stop "${timers[@]}" duducar.service duducar-credential-broker.service
"$render_runtime_env"
systemctl start duducar-credential-broker.service
"$stack_command" deploy
"$command_command" migrate
"$command_command" grant-runtime
"$command_command" migration-check
systemctl enable duducar-credential-broker.service duducar.service "${timers[@]}"
systemctl start duducar.service "${timers[@]}"
"$command_command" readiness
"$stack_command" assert-release
systemctl is-active --quiet duducar-credential-broker.service duducar.service "${timers[@]}"
systemctl is-enabled --quiet duducar-credential-broker.service duducar.service "${timers[@]}"
"$command_command" backup
"$host_health_command"
"$alert_command" --clear duducar-activation \
  "Release activation $operation_id completed and its remote backup was verified."
traffic_changed=0
echo "Release activation completed with reviewed image, version, service, timer, and remote-backup assertions."
