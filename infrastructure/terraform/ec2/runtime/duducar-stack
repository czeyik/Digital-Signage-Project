#!/bin/bash
set -euo pipefail
umask 0077

host_config=/etc/duducar/host.env
release_config=/etc/duducar/release.env
runtime_dir=/run/duducar
openmaptiles_host_dir=/srv/duducar/openmaptiles
if [ -n "${DUDUCAR_STACK_TEST_ROOT:-}" ]; then
  [[ "$DUDUCAR_STACK_TEST_ROOT" =~ ^/tmp/duducar-stack-test\.[A-Za-z0-9]{6,}$ ]] || {
    echo "Stack test root is outside the permitted temporary path." >&2
    exit 2
  }
  host_config=$DUDUCAR_STACK_TEST_ROOT/etc/duducar/host.env
  release_config=$DUDUCAR_STACK_TEST_ROOT/etc/duducar/release.env
  runtime_dir=$DUDUCAR_STACK_TEST_ROOT/run/duducar
  openmaptiles_host_dir=$DUDUCAR_STACK_TEST_ROOT/srv/duducar/openmaptiles
fi
network=duducar
network_subnet=172.30.0.0/24
network_gateway=172.30.0.1
database_ip=172.30.0.11
web_ip=172.30.0.10
caddy_ip=172.30.0.12

if [ ! -f "$release_config" ]; then
  echo "Missing $release_config; install it through the reviewed release configuration document." >&2
  exit 1
fi

set -a
source "$host_config"
source "$release_config"
set +a

OPENMAPTILES_MBTILES_PATH=${OPENMAPTILES_MBTILES_PATH:-/openmaptiles/malaysia.mbtiles}
case "$OPENMAPTILES_MBTILES_PATH" in
  /openmaptiles/*.mbtiles) ;;
  *)
    echo "OPENMAPTILES_MBTILES_PATH must point inside /openmaptiles." >&2
    exit 1
    ;;
esac

for name in BACKEND_IMAGE POSTGRES_IMAGE CADDY_IMAGE CADDY_CONFIG; do
  if [ -z "${!name:-}" ]; then
    echo "Required release setting is empty: $name" >&2
    exit 1
  fi
done

for image in "$BACKEND_IMAGE" "$POSTGRES_IMAGE" "$CADDY_IMAGE"; do
  if ! [[ "$image" =~ @sha256:[0-9a-f]{64}$ ]]; then
    echo "Every production image must be pinned by sha256 digest: $image" >&2
    exit 1
  fi
done

case "$CADDY_CONFIG" in
  /etc/duducar/Caddyfile.post-cutover) ;;
  /etc/duducar/Caddyfile.preflight|/etc/duducar/Caddyfile.production)
    echo "The selected Caddyfile is a retired migration artifact; current production requires Caddyfile.post-cutover." >&2
    exit 1
    ;;
  *)
    echo "CADDY_CONFIG must select /etc/duducar/Caddyfile.post-cutover." >&2
    exit 1
    ;;
esac

cleanup_docker_auth() {
  [ -z "${docker_auth:-}" ] || rm -f "$docker_auth/config.json"
}
trap cleanup_docker_auth EXIT

ensure_network() {
  if docker network inspect "$network" >/dev/null 2>&1; then
    actual_subnet=$(docker network inspect --format '{{(index .IPAM.Config 0).Subnet}}' "$network")
    actual_bridge=$(docker network inspect --format '{{index .Options "com.docker.network.bridge.name"}}' "$network")
    if [ "$actual_subnet" != "$network_subnet" ] || [ "$actual_bridge" != duducar0 ]; then
      echo "Existing Docker network does not match the reviewed DUDU subnet and bridge." >&2
      exit 1
    fi
    return
  fi
  docker network create \
    --driver bridge \
    --subnet "$network_subnet" \
    --gateway "$network_gateway" \
    --opt com.docker.network.bridge.name=duducar0 \
    "$network" >/dev/null
}

login_ecr() {
  docker_auth="$runtime_dir/docker-auth"
  install -d -o root -g root -m 0700 "$docker_auth"
  export DOCKER_CONFIG="$docker_auth"
  ecr_registry=${BACKEND_IMAGE%%/*}
  aws ecr get-login-password --region "${AWS_REGION:-ap-southeast-5}" |
    docker login --username AWS --password-stdin "$ecr_registry" >/dev/null
}

pull_images() {
  login_ecr
  docker pull "$BACKEND_IMAGE"
  docker pull "$POSTGRES_IMAGE"
  docker pull "$CADDY_IMAGE"
}

create_database() {
  publish_database=${1:-true}
  docker_args=(
    docker run -d \
    --name duducar-postgres \
    --network "$network" \
    --ip "$database_ip" \
    --log-driver journald \
    --security-opt no-new-privileges:true \
    --pids-limit 256 \
    --memory 640m \
    --cpus 1.0 \
    --env-file "$runtime_dir/postgres.env" \
    --volume /srv/duducar/postgres:/var/lib/postgresql/data \
    --volume /srv/duducar/postgres-secrets:/run/postgres-local-secrets:ro \
    --volume /srv/duducar/postgres-tls:/run/postgres-tls:ro \
    --volume "$runtime_dir/postgres-secrets:/run/postgres-runtime-secrets:ro" \
    --volume /etc/duducar/postgres-init/postgres-init-roles.sh:/docker-entrypoint-initdb.d/010-roles.sh:ro \
    --volume /etc/duducar/postgres-init/postgres-runtime-grants.sql:/docker-entrypoint-initdb.d/020-runtime-grants.sql:ro \
    --volume /etc/duducar/postgres-init/postgres-runtime-grants.sql:/run/postgres-config/runtime-grants.sql:ro \
    --volume /etc/duducar/pg_hba.conf:/run/postgres-config/pg_hba.conf:ro \
    --health-cmd 'pg_isready -U duducar_admin -d signage' \
    --health-interval 10s \
    --health-timeout 5s \
    --health-retries 12 \
  )
  if [ "$publish_database" = true ]; then
    docker_args+=(--publish 5432:5432)
  fi
  docker_args+=(
    "$POSTGRES_IMAGE" \
    -c ssl=on \
    -c ssl_cert_file=/run/postgres-tls/server.crt \
    -c ssl_key_file=/run/postgres-tls/server.key \
    -c ssl_min_protocol_version=TLSv1.2 \
    -c hba_file=/run/postgres-config/pg_hba.conf \
    -c listen_addresses=* \
    -c password_encryption=scram-sha-256 \
    -c shared_buffers=128MB \
    -c max_connections=50
  )
  "${docker_args[@]}" >/dev/null
}

wait_for_database() {
  for attempt in $(seq 1 60); do
    status=$(docker inspect --format '{{.State.Health.Status}}' duducar-postgres 2>/dev/null || true)
    if [ "$status" = "healthy" ]; then
      return
    fi
    if [ "$status" = "unhealthy" ]; then
      docker logs --tail 40 duducar-postgres >&2
      return 1
    fi
    sleep 2
  done
  echo "PostgreSQL did not become healthy within two minutes." >&2
  return 1
}

create_web() {
  docker run -d \
    --name duducar-web \
    --network "$network" \
    --ip "$web_ip" \
    --log-driver journald \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --pids-limit 256 \
    --memory 768m \
    --cpus 1.5 \
    --env-file "$runtime_dir/application.env" \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,size=256m \
    --volume /srv/duducar/backups:/backups \
    --volume "$openmaptiles_host_dir:/openmaptiles:ro" \
    --volume "$runtime_dir/backend-secrets:/run/duducar/backend-secrets:ro" \
    --health-cmd "python -c \"import urllib.request; req=urllib.request.Request('http://127.0.0.1:8000/health/live/', headers={'Host':'marketing.duducaradmin.com'}); urllib.request.urlopen(req, timeout=3)\"" \
    --health-interval 30s \
    --health-timeout 5s \
    --health-retries 5 \
    "$BACKEND_IMAGE" >/dev/null
}

wait_for_web() {
  for attempt in $(seq 1 60); do
    status=$(docker inspect --format '{{.State.Health.Status}}' duducar-web 2>/dev/null || true)
    if [ "$status" = "healthy" ]; then
      return
    fi
    if [ "$status" = "unhealthy" ]; then
      docker logs --tail 60 duducar-web >&2
      return 1
    fi
    sleep 2
  done
  echo "Django did not become healthy within two minutes." >&2
  return 1
}

create_caddy() {
  docker run -d \
    --name duducar-caddy \
    --network "$network" \
    --ip "$caddy_ip" \
    --log-driver journald \
    --cap-drop ALL \
    --cap-add NET_BIND_SERVICE \
    --security-opt no-new-privileges:true \
    --pids-limit 128 \
    --memory 128m \
    --cpus 0.5 \
    --publish 80:80 \
    --publish 443:443 \
    --publish 443:443/udp \
    --volume "$CADDY_CONFIG:/etc/caddy/Caddyfile:ro" \
    --volume /srv/duducar/caddy-data:/data \
    --volume /srv/duducar/caddy-config:/config \
    "$CADDY_IMAGE" >/dev/null
}

remove_container() {
  name=$1
  if docker container inspect "$name" >/dev/null 2>&1; then
    docker rm --force "$name" >/dev/null
  fi
}

remove_database_container() {
  if docker container inspect duducar-postgres >/dev/null 2>&1; then
    # PostgreSQL receives SIGTERM and completes a fast, clean shutdown before
    # its container metadata is removed. A failed stop aborts the deployment.
    if [ "$(docker inspect --format '{{.State.Running}}' duducar-postgres 2>/dev/null || true)" = true ]; then
      docker stop --time 120 duducar-postgres >/dev/null
    fi
    docker rm duducar-postgres >/dev/null
  fi
}

assert_container_config() {
  name=$1
  expected_image=$2
  expected_ip=$3
  if ! container_config_matches "$name" "$expected_image" "$expected_ip"; then
    echo "Container $name does not match the reviewed image, systemd-only lifecycle, or network identity; run an audited deploy." >&2
    exit 1
  fi
}

container_config_matches() {
  name=$1
  expected_image=$2
  expected_ip=$3
  current_image=$(docker inspect --format '{{.Config.Image}}' "$name")
  restart_policy=$(docker inspect --format '{{.HostConfig.RestartPolicy.Name}}' "$name")
  current_ip=$(docker inspect --format '{{with index .NetworkSettings.Networks "duducar"}}{{if .IPAddress}}{{.IPAddress}}{{else}}{{with .IPAMConfig}}{{.IPv4Address}}{{end}}{{end}}{{end}}' "$name")
  [ "$current_image" = "$expected_image" ] && \
    { [ -z "$restart_policy" ] || [ "$restart_policy" = no ]; } && \
    [ "$current_ip" = "$expected_ip" ]
}

ensure_openmaptiles_dir() {
  if [ -L "$openmaptiles_host_dir" ]; then
    echo "OpenMapTiles directory must not be a symlink." >&2
    exit 1
  fi
  if [ -n "${DUDUCAR_STACK_TEST_ROOT:-}" ]; then
    install -d -m 0755 "$openmaptiles_host_dir"
  else
    install -d -o root -g root -m 0755 "$openmaptiles_host_dir"
  fi
}

prepare_stack() {
  ensure_network
  ensure_openmaptiles_dir
}

start_container_if_stopped() {
  name=$1
  if [ "$(docker inspect --format '{{.State.Running}}' "$name")" != true ]; then
    docker start "$name" >/dev/null
  fi
}

database_port_published() {
  [ "$(docker inspect --format '{{with index .HostConfig.PortBindings "5432/tcp"}}{{(index . 0).HostPort}}{{end}}' duducar-postgres 2>/dev/null || true)" = 5432 ]
}

start_database() {
  publish_database=${1:-true}
  ensure_network

  if docker container inspect duducar-postgres >/dev/null 2>&1; then
    assert_container_config duducar-postgres "$POSTGRES_IMAGE" "$database_ip"
    if [ "$publish_database" = true ] && ! database_port_published; then
      remove_database_container
      create_database true
    else
      start_container_if_stopped duducar-postgres
    fi
  else
    create_database "$publish_database"
  fi
  wait_for_database
}

start_stack() {
  ensure_network
  ensure_openmaptiles_dir

  start_database

  if docker container inspect duducar-web >/dev/null 2>&1; then
    assert_container_config duducar-web "$BACKEND_IMAGE" "$web_ip"
    start_container_if_stopped duducar-web
  else
    create_web
  fi
  wait_for_web

  if docker container inspect duducar-caddy >/dev/null 2>&1; then
    assert_container_config duducar-caddy "$CADDY_IMAGE" "$caddy_ip"
    start_container_if_stopped duducar-caddy
  else
    create_caddy
  fi
}

backup_start() {
  # The stopped-state refresh has no public listener and no web service. The
  # one-shot backend runner only needs PostgreSQL and the credential broker.
  start_database false
}

backup_stop() {
  if docker container inspect duducar-postgres >/dev/null 2>&1 &&
    [ "$(docker inspect --format '{{.State.Running}}' duducar-postgres 2>/dev/null || true)" = true ]; then
    docker stop --time 30 duducar-postgres >/dev/null
  fi
}

deploy_stack() {
  ensure_network
  ensure_openmaptiles_dir
  pull_images

  remove_container duducar-caddy
  remove_container duducar-web

  if docker container inspect duducar-postgres >/dev/null 2>&1; then
    if ! container_config_matches duducar-postgres "$POSTGRES_IMAGE" "$database_ip" ||
      ! database_port_published; then
      remove_database_container
    fi
  fi

  if ! docker container inspect duducar-postgres >/dev/null 2>&1; then
    create_database
  else
    docker start duducar-postgres >/dev/null
  fi
  wait_for_database
  create_web
  wait_for_web
  # Keep public traffic absent until migrations, grants, and readiness checks
  # complete and systemd starts the reviewed stack.
}

monitor_stack() {
  while true; do
    for specification in \
      "duducar-postgres|$POSTGRES_IMAGE|$database_ip|healthy" \
      "duducar-web|$BACKEND_IMAGE|$web_ip|healthy" \
      "duducar-caddy|$CADDY_IMAGE|$caddy_ip|none"; do
      IFS='|' read -r name image ip expected_health <<< "$specification"
      if ! docker container inspect "$name" >/dev/null 2>&1; then
        echo "Managed container disappeared: $name" >&2
        return 1
      fi
      assert_container_config "$name" "$image" "$ip"
      if [ "$(docker inspect --format '{{.State.Running}}' "$name")" != true ]; then
        echo "Managed container stopped: $name" >&2
        return 1
      fi
      if [ "$expected_health" != none ] && \
        [ "$(docker inspect --format '{{.State.Health.Status}}' "$name")" != "$expected_health" ]; then
        echo "Managed container is not healthy: $name" >&2
        return 1
      fi
    done
    sleep 10
  done
}

assert_release() {
  assert_container_config duducar-postgres "$POSTGRES_IMAGE" "$database_ip"
  assert_container_config duducar-web "$BACKEND_IMAGE" "$web_ip"
  assert_container_config duducar-caddy "$CADDY_IMAGE" "$caddy_ip"
  for name in duducar-postgres duducar-web duducar-caddy; do
    [ "$(docker inspect --format '{{.State.Running}}' "$name")" = true ] || {
      echo "Released container is not running: $name" >&2
      return 1
    }
  done
  [ "$(docker inspect --format '{{.State.Health.Status}}' duducar-postgres)" = healthy ]
  [ "$(docker inspect --format '{{.State.Health.Status}}' duducar-web)" = healthy ]
  docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' duducar-web |
    grep -Fxq "REQUIRED_APP_VERSION=$REQUIRED_APP_VERSION"
}

stop_stack() {
  for name in duducar-caddy duducar-web duducar-postgres; do
    if docker container inspect "$name" >/dev/null 2>&1 &&
      [ "$(docker inspect --format '{{.State.Running}}' "$name" 2>/dev/null || true)" = true ]; then
      docker stop --time 30 "$name" >/dev/null
    fi
  done
}

case "${1:-start}" in
  prepare)
    prepare_stack
    ;;
  start)
    start_stack
    ;;
  backup-start)
    backup_start
    ;;
  backup-stop)
    backup_stop
    ;;
  deploy)
    deploy_stack
    ;;
  monitor)
    monitor_stack
    ;;
  assert-release)
    assert_release
    ;;
  stop)
    stop_stack
    ;;
  status)
    docker ps --filter name=duducar- --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
    ;;
  *)
    echo "Usage: duducar-stack {prepare|start|backup-start|backup-stop|deploy|monitor|assert-release|stop|status}" >&2
    exit 2
    ;;
esac
