#!/bin/bash
set -euo pipefail
umask 0077

host_config=/etc/duducar-recovery/host.env
release_config=/etc/duducar-recovery/release.env
runtime_dir=/run/duducar-recovery
local_postgres_secrets=/srv/duducar/postgres-secrets

for config in "$host_config" "$release_config"; do
  if [ ! -f "$config" ]; then
    echo "Missing required recovery configuration: $config" >&2
    exit 1
  fi
  owner=$(stat -c '%U:%G' "$config")
  mode=$(stat -c '%a' "$config")
  if [ "$owner" != root:root ] || [ $((8#$mode & 0022)) -ne 0 ]; then
    echo "Recovery configuration ownership or mode is unsafe: $config" >&2
    exit 1
  fi
done

/usr/local/sbin/duducar-recovery-mount verify-mounted >/dev/null

set -a
source "$host_config"
source "$release_config"
set +a

for image in "$BACKEND_IMAGE" "$POSTGRES_IMAGE" "$CADDY_IMAGE"; do
  if ! [[ "$image" =~ @sha256:[0-9a-f]{64}$ ]]; then
    echo "Recovery images must all be pinned by digest." >&2
    exit 1
  fi
done

for name in \
  AWS_REGION \
  APPLICATION_SECRET_ARN \
  AWS_STORAGE_BUCKET_NAME \
  DJANGO_ALLOWED_HOSTS \
  DJANGO_CSRF_TRUSTED_ORIGINS \
  REQUIRED_APP_VERSION \
  PLAY_INTEGRITY_PROJECT_NUMBER \
  AWS_S3_CUSTOM_DOMAIN \
  AWS_CLOUDFRONT_KEY_ID; do
  if [ -z "${!name:-}" ]; then
    echo "Required recovery setting is empty: $name" >&2
    exit 1
  fi
done

for path in \
  "$local_postgres_secrets/admin-password" \
  "$local_postgres_secrets/owner-password"; do
  if [ ! -s "$path" ]; then
    echo "The mounted recovery volume lacks expected PostgreSQL role material." >&2
    exit 1
  fi
done

install -d -o root -g root -m 0700 "$runtime_dir"
backend_secrets_dir="$runtime_dir/backend-secrets"
owner_secrets_dir="$runtime_dir/database-owner"
postgres_runtime_secrets_dir="$runtime_dir/postgres-secrets"
install -d -o 10001 -g 10001 -m 0500 "$backend_secrets_dir"
install -d -o 10001 -g 10001 -m 0500 "$owner_secrets_dir"
install -d -o 70 -g 70 -m 0500 "$postgres_runtime_secrets_dir"

staging_dir=$(mktemp -d "$runtime_dir/render.XXXXXX")
trap 'rm -rf "$staging_dir"' EXIT
secret_tmp="$staging_dir/application-secret.json"
application_tmp="$staging_dir/application.env"
postgres_tmp="$staging_dir/postgres.env"

aws secretsmanager get-secret-value \
  --region "$AWS_REGION" \
  --secret-id "$APPLICATION_SECRET_ARN" \
  --query SecretString \
  --output text > "$secret_tmp"

jq -e 'type == "object"' "$secret_tmp" >/dev/null

extract_secret_string() {
  key=$1
  destination=$2
  jq -er --arg key "$key" \
    '.[$key] | select(type == "string" and length > 0)' \
    "$secret_tmp" > "$destination"
}

emit() {
  key=$1
  value=$2
  case "$value" in
    *$'\n'*|*$'\r'*)
      echo "Configuration value cannot contain a line break: $key" >&2
      exit 1
      ;;
  esac
  printf '%s=%s\n' "$key" "$value"
}

extract_secret_string DJANGO_SECRET_KEY "$staging_dir/django-secret-key"
if [ "$(wc -c < "$staging_dir/django-secret-key")" -lt 50 ]; then
  echo "DJANGO_SECRET_KEY is unexpectedly short." >&2
  exit 1
fi
extract_secret_string DB_PASSWORD "$staging_dir/database-password"
extract_secret_string WORKER_DB_PASSWORD "$staging_dir/worker-database-password"
worker_database_password=$(<"$staging_dir/worker-database-password")
case "$worker_database_password" in
  *$'\n'*|*$'\r'*)
    echo "WORKER_DB_PASSWORD must not contain a line break." >&2
    exit 1
    ;;
esac
extract_secret_string PLAY_INTEGRITY_APP_CERTIFICATE_SHA256 "$staging_dir/play-integrity-app-certificates"
play_integrity_app_certificates=$(<"$staging_dir/play-integrity-app-certificates")
if ! [[ "$play_integrity_app_certificates" =~ ^[0-9a-f]{64}(,[0-9a-f]{64})*$ ]]; then
  echo "PLAY_INTEGRITY_APP_CERTIFICATE_SHA256 must contain canonical comma-separated SHA-256 fingerprints." >&2
  exit 1
fi
jq -cer '
  .PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON
  | if type == "string" then fromjson else . end
' "$secret_tmp" > "$staging_dir/play-integrity.json"
jq -er '.AWS_CLOUDFRONT_PRIVATE_KEY | select(type == "string" and contains("PRIVATE KEY"))' \
  "$secret_tmp" > "$staging_dir/cloudfront-private.pem"
openssl pkey -in "$staging_dir/cloudfront-private.pem" -check -noout >/dev/null

{
  emit DJANGO_DEBUG false
  emit DEPLOYMENT_ENV production
  emit DEPLOYMENT_COMPONENT web
  emit DJANGO_ALLOWED_HOSTS "$DJANGO_ALLOWED_HOSTS"
  emit DJANGO_CSRF_TRUSTED_ORIGINS "$DJANGO_CSRF_TRUSTED_ORIGINS"
  emit DJANGO_SECURE_SSL_REDIRECT true
  emit DJANGO_TRUST_X_FORWARDED_PROTO true
  emit DJANGO_USE_X_FORWARDED_HOST false
  emit DB_HOST duducar-recovery-postgres
  emit DB_PORT 5432
  emit DB_NAME signage
  emit DB_USER signage_app
  emit DB_PASSWORD_FILE /run/duducar-recovery/backend-secrets/database-password
  emit DB_SSLMODE require
  emit AWS_EC2_METADATA_DISABLED true
  emit AWS_STORAGE_BUCKET_NAME "$AWS_STORAGE_BUCKET_NAME"
  emit AWS_S3_REGION_NAME "$AWS_REGION"
  emit AWS_S3_CUSTOM_DOMAIN "$AWS_S3_CUSTOM_DOMAIN"
  emit AWS_CLOUDFRONT_KEY_ID "$AWS_CLOUDFRONT_KEY_ID"
  emit AWS_CLOUDFRONT_PRIVATE_KEY_FILE /run/duducar-recovery/backend-secrets/cloudfront-private.pem
  emit PILOT_BACKUP_ROOT /backups
  emit PILOT_BACKUP_S3_BUCKET ''
  emit PILOT_BACKUP_RETENTION_DAYS 3
  emit PILOT_BACKUP_MAX_LOCAL_ARCHIVES 3
  emit REQUIRED_APP_VERSION "$REQUIRED_APP_VERSION"
  emit PLAY_INTEGRITY_PROJECT_NUMBER "$PLAY_INTEGRITY_PROJECT_NUMBER"
  emit PLAY_INTEGRITY_PACKAGE_NAME com.duducar.signage
  emit PLAY_INTEGRITY_APP_CERTIFICATE_SHA256 "$play_integrity_app_certificates"
  emit PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON_FILE /run/duducar-recovery/backend-secrets/play-integrity.json
  emit MEDIA_MAX_REQUEST_BYTES 53477376
  emit MEDIA_MAX_IMAGE_PIXELS 25000000
  emit MEDIA_MAX_IMAGE_DIMENSION 10000
  emit MEDIA_CLAMAV_TIMEOUT_SECONDS 120
  emit MEDIA_FFPROBE_TIMEOUT_SECONDS 30
  emit MEDIA_FFMPEG_TIMEOUT_SECONDS 300
  emit FRESHCLAM_TIMEOUT_SECONDS 120
  emit MEDIA_WORKER_TIMEOUT_SECONDS 1200
  emit MEDIA_PROCESSING_LEASE_SECONDS 1800
  emit MEDIA_DISPATCH_RETRY_SECONDS 600
  emit MEDIA_MAX_DISPATCH_ATTEMPTS 5
  emit MEDIA_RECONCILE_MAX_ASSETS 25
  emit MEDIA_DISPATCH_MAX_CONCURRENT_TASKS 2
  emit MEDIA_DISPATCH_MAX_TASKS_PER_HOUR 6
  emit MEDIA_DISPATCH_STARTUP_GRACE_SECONDS 120
  emit MEDIA_DISPATCH_AMBIGUITY_REUSE_SECONDS 900
  emit MEDIA_DISPATCH_AWS_CONNECT_TIMEOUT_SECONDS 5
  emit MEDIA_DISPATCH_AWS_READ_TIMEOUT_SECONDS 10
  emit MEDIA_PROCESSING_DISPATCH_BACKEND ecs
  emit ECS_MEDIA_REGION "$AWS_REGION"
  emit ECS_MEDIA_CLUSTER recovery-smoke-disabled
  emit ECS_MEDIA_TASK_DEFINITION recovery-smoke-disabled
  emit ECS_MEDIA_CONTAINER_NAME application
  emit ECS_MEDIA_SUBNET_IDS recovery-smoke-disabled
  emit ECS_MEDIA_SECURITY_GROUP_IDS recovery-smoke-disabled
  emit ECS_MEDIA_ASSIGN_PUBLIC_IP false
  emit EMAIL_BACKEND django.core.mail.backends.locmem.EmailBackend
  emit DEFAULT_FROM_EMAIL recovery-smoke@invalid.example
  emit SERVER_EMAIL recovery-smoke@invalid.example
  emit DJANGO_SECRET_KEY_FILE /run/duducar-recovery/backend-secrets/django-secret-key
  emit LOG_LEVEL INFO
} > "$application_tmp"

{
  emit POSTGRES_DB signage
  emit POSTGRES_USER duducar_admin
  emit POSTGRES_PASSWORD_FILE /run/postgres-local-secrets/admin-password
  emit OWNER_DB_PASSWORD_FILE /run/postgres-local-secrets/owner-password
  emit RUNTIME_DB_PASSWORD_FILE /run/postgres-runtime-secrets/runtime-password
  emit WORKER_DB_PASSWORD_FILE /run/postgres-runtime-secrets/worker-password
  emit PGDATA /var/lib/postgresql/data/pgdata
} > "$postgres_tmp"

install -o 70 -g 70 -m 0400 \
  "$staging_dir/database-password" \
  "$postgres_runtime_secrets_dir/runtime-password"
install -o 70 -g 70 -m 0400 \
  "$staging_dir/worker-database-password" \
  "$postgres_runtime_secrets_dir/worker-password"
install -o 10001 -g 10001 -m 0400 \
  "$local_postgres_secrets/owner-password" \
  "$owner_secrets_dir/database-owner-password"

for secret_name in django-secret-key database-password play-integrity.json cloudfront-private.pem; do
  chown 10001:10001 "$staging_dir/$secret_name"
  chmod 0400 "$staging_dir/$secret_name"
  mv -f "$staging_dir/$secret_name" "$backend_secrets_dir/$secret_name"
done

chown root:root "$application_tmp" "$postgres_tmp"
chmod 0600 "$application_tmp" "$postgres_tmp"
mv -f "$application_tmp" "$runtime_dir/application.env"
mv -f "$postgres_tmp" "$runtime_dir/postgres.env"

trap - EXIT
rm -rf "$staging_dir"
