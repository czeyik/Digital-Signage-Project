DJANGO_DEBUG=true
DEPLOYMENT_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_USE_X_FORWARDED_HOST=false
DATABASE_URL=postgresql://signage:local-development-only@localhost:5432/signage
DB_SSLMODE=disable
DB_HOST=
DB_PORT=5432
DB_NAME=signage
DB_USER=signage
DB_PASSWORD=
REQUIRED_APP_VERSION=0.1.0
# Optional local OpenMapTiles basemap. Production mounts the verified MBTiles
# file at this path and serves it through the authenticated dashboard routes.
OPENMAPTILES_STYLE_URL=/locations/style.json
OPENMAPTILES_MBTILES_PATH=/openmaptiles/malaysia.mbtiles
OPENMAPTILES_MAX_ZOOM=14
DEVICE_OVERHEAT_CELSIUS=45
PILOT_BACKUP_ROOT=backend/backups
PILOT_BACKUP_RETENTION_DAYS=30
PILOT_BACKUP_S3_BUCKET=
DEFAULT_FROM_EMAIL=no-reply@duducar.co
SERVER_EMAIL=no-reply@duducar.co
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

# Production only. The USD 30 architecture serves private S3 media through
# signed CloudFront URLs. Use separate credentials, buckets, distributions,
# and signing keys for each environment.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_CLOUDFRONT_KEY_ID=
# Prefer the file-backed form on the EC2 host. Never commit the private key.
AWS_CLOUDFRONT_PRIVATE_KEY_FILE=

# Production only. Media processing is dispatched as a short-lived, isolated
# Fargate task for each asset; there is no continuously running ECS worker.
# Keep this disabled for local development unless a developer explicitly
# supplies an isolated test environment.
MEDIA_PROCESSING_DISPATCH_BACKEND=disabled
MEDIA_PROCESSING_LEASE_SECONDS=1800
MEDIA_DISPATCH_RETRY_SECONDS=600
MEDIA_MAX_DISPATCH_ATTEMPTS=5
MEDIA_RECONCILE_MAX_ASSETS=25
ECS_MEDIA_REGION=
ECS_MEDIA_CLUSTER=
ECS_MEDIA_TASK_DEFINITION=
ECS_MEDIA_CONTAINER_NAME=application
ECS_MEDIA_SUBNET_IDS=
ECS_MEDIA_SECURITY_GROUP_IDS=
ECS_MEDIA_ASSIGN_PUBLIC_IP=false

# Production device-integrity configuration. Store the JSON value in a secret
# manager; never commit the real credential.
PLAY_INTEGRITY_PROJECT_NUMBER=
PLAY_INTEGRITY_PACKAGE_NAME=com.duducar.signage
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
PLAY_INTEGRITY_MAX_TOKEN_AGE_SECONDS=120
DEVICE_MEDIA_CACHE_BYTES=10737418240
DEVICE_EVENT_QUEUE_BYTES=524288000
DEVICE_MIN_FREE_BYTES=2147483648
